# Copiez ce fichier en « .env » (même dossier) et remplissez les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.

# Chaîne de connexion Neon, collée telle quelle depuis le tableau de bord Neon
# (bouton « Connect », format « postgresql://… »). Prenez la connexion directe, pas « pooled ».
DATABASE_URL=

# Clé secrète qui signe les sessions. Générez-la avec la commande :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Adresse de l'application web autorisée à appeler le serveur.
CORS_ORIGINS=http://localhost:3000
